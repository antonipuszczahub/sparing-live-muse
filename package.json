{
  "name": "sparing-live-muse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time voice sparring on Meta Muse models",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:meta": "tsx --env-file=.env scripts/check-meta.ts",
    "try:turn": "tsx --env-file=.env scripts/try-turn.ts",
    "try:audit": "tsx --env-file=.env scripts/try-audit.ts",
    "try:twin": "tsx --env-file=.env scripts/try-twin.ts",
    "try:portrait": "tsx --env-file=.env scripts/try-portrait.ts",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "check:open": "tsx --env-file=.env scripts/check-open.ts",
    "manifest": "tsx --env-file=.env scripts/manifest.ts",
    "check:voice": "tsx --env-file=.env scripts/check-voice.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "openai": "^7.45.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
