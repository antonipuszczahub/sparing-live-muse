# Meta Model API key from https://dev.meta.ai (never commit the real one)
MODEL_API_KEY=

# Optional: run the character on open weights (Muse Spark Open). Pick ONE host.
#
# Baseten: the key is enough, the hackathon model id meta-models/muse-spark-open-1026 is built in.
BASETEN_API_KEY=
#
# Fireworks: key plus the model id of your deployment.
# FIREWORKS_API_KEY=
# OPEN_MODEL=
#
# Local Ollama, no key: OPEN_HOST=ollama and the model you pulled.
# OPEN_HOST=ollama
# OPEN_MODEL=
#
# Any OpenAI-compatible endpoint, for example vLLM deployed on Modal.
# OPEN_BASE_URL=https://<workspace>--<app>-serve.modal.run/v1
# OPEN_API_KEY=
# OPEN_MODEL=
#
# Optional: force a host when several keys are set (baseten, fireworks, ollama, custom) or rename it in the UI.
# OPEN_HOST=
# OPEN_LABEL=

# Spend caps in USD, enforced by the server. Meta's own spend limit is notification-only.
DAILY_BUDGET_USD=5
SESSION_BUDGET_USD=1

# Per-visitor limits for a public deployment
SESSIONS_PER_IP_HOUR=6
TWINS_PER_IP_HOUR=5

# A researched company is reused for this many hours (same company, scenario and pitch)
TWIN_CACHE_HOURS=24

# ---- Voice of the character (optional) ---------------------------------------------------------
# Without a key the character speaks with the browser's own voice (Edge's Natural voices are the best of those).
# ElevenLabs is NOT a Meta model, and the hackathon allows only Meta models at runtime, so the server ignores the
# key below unless THIRD_PARTY_VOICE=on. Leave it unset for the demo and for the hosted link. It exists only for
# local experiments with a studio-quality voice (the key stays on the server; the browser asks /api/tts).
# THIRD_PARTY_VOICE=on
ELEVENLABS_API_KEY=
# eleven_v4_turbo: real time, 90+ languages, $0.04 per 1K characters. eleven_flash_v2_5 is the cheaper fallback.
ELEVENLABS_MODEL=eleven_v4_turbo
# Used for the cost estimate in docs/MANIFEST.md (the price on https://elevenlabs.io/pricing/api).
ELEVENLABS_USD_PER_1K_CHARS=0.04
# Optional: force a voice per language and gender (voice ids from `npm run check:voice`).
# ELEVENLABS_VOICE_PL_F=
# ELEVENLABS_VOICE_PL_M=
# Caps in characters. A 5-minute call is about 2,000, so these allow a few calls per visitor and ~75 calls a day.
TTS_CHARS_PER_SESSION=8000
TTS_CHARS_PER_IP_HOUR=20000
TTS_DAILY_CHARS=150000
